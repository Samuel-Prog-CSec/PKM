views:
  - type: table
    name: Notas
    filters:
      Area == link("ProjectDiscovery.base", "ProjectDiscovery")
    order:
      - file.name
      - Descripción
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 360
      note.Descripción: 500
      file.tags: 240
      note.Fecha de actualización: 140
