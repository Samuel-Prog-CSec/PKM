views:
  - type: cards
    name: Vista
    filters:
      and:
        - file.folder == "02 - Recursos/Biblioteca/Book-notes"
        - Estado == "Aceptada"
    order:
      - file.name
      - Autores
      - Estado
    imageAspectRatio: 1.55
    image: Portada
    cardSize: 210
  - type: table
    name: Tabla
    filters:
      and:
        - file.folder == "02 - Recursos/Biblioteca/Book-notes"
    order:
      - file.name
      - Autores
      - Editorial
      - Año
      - Estado
      - Rating
