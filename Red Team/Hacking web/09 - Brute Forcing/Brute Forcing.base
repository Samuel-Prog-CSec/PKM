views:
  - type: table
    name: Notas
    filters: Area == link("Brute Forcing.base", "Brute Forcing")
    order:
      - file.name
      - Descripción
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 330
      note.Descripción: 520
      file.tags: 530
      note.Fecha de actualización: 140
