views:
  - type: table
    name: Notas
    filters:
      Area == link("Reconocimiento Web.base", "Reconocimiento Web")
    order:
      - file.name
      - Descripción
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 330
      note.Descripción: 480
      file.tags: 300
      note.Fecha de actualización: 150
  - type: table
    name: Recon
    filters:
      and:
        - Area == link("Reconocimiento Web.base", "Reconocimiento Web")
        - file.hasTag("Recon")
    order:
      - file.name
      - Descripción
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 330
      note.Descripción: 480
      file.tags: 300
      note.Fecha de actualización: 150
  - type: table
    name: Fuzzing
    filters:
      and:
        - Area == link("Reconocimiento Web.base", "Reconocimiento Web")
        - file.hasTag("Fuzzing")
    order:
      - file.name
      - Descripción
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 330
      note.Descripción: 480
      file.tags: 300
      note.Fecha de actualización: 150
