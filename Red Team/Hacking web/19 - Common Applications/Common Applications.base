formulas:
  aplicación: file.folder.replace("Red Team/Hacking web/19 - Common Applications", "").replace("/", "")
properties:
  formula.aplicación:
    displayName: Aplicación
views:
  - type: table
    name: Por aplicación
    filters: Area == link("Common Applications.base", "Common Applications")
    groupBy:
      property: formula.aplicación
      direction: ASC
    order:
      - file.name
      - Descripción
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 330
      note.Descripción: 480
      file.tags: 280
      note.Fecha de actualización: 150
  - type: table
    name: Todas
    filters: Area == link("Common Applications.base", "Common Applications")
    order:
      - file.name
      - Descripción
      - formula.aplicación
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.folder
        direction: ASC
    columnSize:
      file.name: 330
      note.Descripción: 480
      formula.aplicación: 180
      file.tags: 260
      note.Fecha de actualización: 150
