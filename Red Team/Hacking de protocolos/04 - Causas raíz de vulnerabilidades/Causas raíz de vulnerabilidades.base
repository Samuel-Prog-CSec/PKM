views:
  - type: table
    name: Notas
    filters:
      Area == link("Causas raíz de vulnerabilidades.base", "Causas raíz de vulnerabilidades")
    order:
      - file.name
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 400
      file.tags: 300
      note.Fecha de actualización: 150
