views:
  - type: table
    name: Notas
    filters:
      Area == link("Análisis de protocolos.base", "Análisis de protocolos")
    order:
      - file.name
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 380
      file.tags: 300
      note.Fecha de actualización: 150
