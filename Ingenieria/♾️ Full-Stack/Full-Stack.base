views:
  - type: table
    name: Sub-temas
    filters:
      and:
        - file.ext == "base"
        - file.folder.startsWith("Ingenieria/♾️ Full-Stack")
        - file.name != "Full-Stack"
    order:
      - file.name
      - file.folder
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 280
      file.folder: 420
