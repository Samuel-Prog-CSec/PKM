formulas:
  indice: file.name.replace(".base", "")
properties:
  formula.indice:
    displayName: Índice
  file.folder:
    displayName: Ubicación
views:
  - type: table
    name: Índices (MOCs)
    filters:
      and:
        - file.ext == "base"
        - file.folder.startsWith("Inglés/")
    order:
      - formula.indice
      - file.folder
    sort: []
    columnSize:
      formula.indice: 300
      file.folder: 440
  - type: table
    name: Todas las notas
    filters:
      and:
        - file.inFolder("Inglés")
        - file.ext == "md"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - Descripción
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 360
      note.Descripción: 460
      file.tags: 220
      note.Fecha de actualización: 140
  - type: table
    name: Deuda · sin Area
    filters:
      and:
        - file.inFolder("Inglés")
        - file.ext == "md"
        - '!file.hasProperty("Area")'
    order:
      - file.name
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
    columnSize:
      file.name: 380
      file.folder: 360
