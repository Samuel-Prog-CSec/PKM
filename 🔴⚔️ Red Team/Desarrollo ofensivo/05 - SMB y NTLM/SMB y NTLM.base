views:
  - type: table
    name: Notas
    filters:
      Area == link("SMB y NTLM.base", "SMB y NTLM")
    order:
      - file.name
      - Descripción
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 330
      note.Descripción: 520
      file.tags: 240
      note.Fecha de actualización: 140