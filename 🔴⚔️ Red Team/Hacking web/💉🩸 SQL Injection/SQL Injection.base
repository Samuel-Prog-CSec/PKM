views:
  - type: table
    name: Todas las notas
    filters: Area == link("SQL Injection.base", "SQL Injection")
    order:
      - file.name
      - file.tags
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 360
      file.tags: 320
  - type: table
    name: Introducción
    filters: file.folder.startsWith("🔴⚔️ Red Team/Hacking web/💉🩸 SQL Injection/1️⃣ Introducción")
    order:
      - file.name
      - file.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Blind SQLi
    filters: file.folder.startsWith("🔴⚔️ Red Team/Hacking web/💉🩸 SQL Injection/2️⃣ Nivel avanzado/Blind")
    order:
      - file.name
      - file.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Advanced SQLi
    filters: file.folder.startsWith("🔴⚔️ Red Team/Hacking web/💉🩸 SQL Injection/2️⃣ Nivel avanzado/Advanced")
    order:
      - file.name
      - file.tags
    sort:
      - property: file.name
        direction: ASC
