views:
  - type: table
    name: Sub-temas
    filters:
      and:
        - file.ext == "base"
        - file.folder.startsWith("01 - Proyectos/GO")
        - file.name != "GO"
    order:
      - file.name
      - file.folder
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 300
      file.folder: 420
