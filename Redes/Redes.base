formulas:
  sub-tema: file.name.replace(".base", "")
properties:
  formula.sub-tema:
    displayName: Sub-tema
  file.folder:
    displayName: Ubicación
views:
  - type: table
    name: Sub-temas
    filters:
      and:
        - file.ext == "base"
        - file.folder.startsWith("Redes/")
    order:
      - formula.sub-tema
      - file.folder
    sort: []
    columnSize:
      formula.sub-tema: 320
      file.folder: 420
  - type: table
    name: Todas las notas
    filters:
      and:
        - file.inFolder("Redes")
        - file.ext == "md"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
      - Fecha de actualización
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 420
      file.tags: 280
      note.Fecha de actualización: 150
  - type: table
    name: Deuda · sin frontmatter
    filters:
      and:
        - file.inFolder("Redes")
        - file.ext == "md"
        - '!file.hasProperty("Area")'
    order:
      - file.name
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
    columnSize:
      file.name: 420
      file.folder: 380
